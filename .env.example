# KnowMind 基础配置
HOST=0.0.0.0
PORT=8000

# 模型配置，Day 05 接入真实模型时填写
ARK_API_KEY=
MODEL=
FAST_MODEL=
BASE_URL=
CHAT_TIMEOUT_SECONDS=60

# 数据库和缓存，Day 06 以后启用
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/knowmind
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=knowmind
REDIS_CACHE_TTL_SECONDS=3600

# 文档上传配置，Day 10 以后启用
DOCUMENT_UPLOAD_MAX_BYTES=20971520

# 鉴权配置，Day 07 以后启用
JWT_SECRET_KEY=please-change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ADMIN_INVITE_CODE=knowmind-admin

# Milvus 和检索配置，Day 13 以后启用
EMBEDDING_PROVIDER=dashscope_multimodal
EMBEDDING_MODEL=tongyi-embedding-vision-plus-2026-03-06
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=60
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=knowmind_embeddings
MILVUS_TIMEOUT=30
DENSE_EMBEDDING_DIM=1024
BM25_STATE_PATH=data/bm25_state.json
